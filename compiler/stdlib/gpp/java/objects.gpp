package gpp.java

import "reflect"

// CanonicalReference returns the most-derived view of a Java object, preserving
// Java null and the ordinary pointer representation of boxed and library types.
func CanonicalReference(value any) any {
    if object, ok := value.(interface{ GppJavaCanonicalObject() any }); ok {
        return object.GppJavaCanonicalObject()
    }
    return NormalizeReference(value)
}

func referenceView[T any](value any) (T, bool) {
    if result, ok := value.(T); ok {
        return result, true
    }
    if object, ok := value.(interface{ GppJavaReferenceView(any) any }); ok {
        var witness T
        result, matched := object.GppJavaReferenceView(witness).(T)
        return result, matched
    }
    var zero T
    return zero, false
}

// CastReference checks a Java reference cast and returns the requested view.
func CastReference[T any](value any) T {
    value = CanonicalReference(value)
    if value == nil {
        var zero T
        return zero
    }
    result, ok := referenceView[T](value)
    if !ok {
        Raise(&ClassCastException{})
    }
    return result
}

// InstanceOf implements a Java reference type test. Null never matches.
func InstanceOf[T any](value any) bool {
    _, ok := MatchReference[T](value)
    return ok
}

// MatchReference supplies the nominal view used by a reference type pattern.
func MatchReference[T any](value any) (T, bool) {
    return referenceView[T](NormalizeReference(CanonicalReference(value)))
}

func interfaceView[T any](value any, javaInterface string) (T, bool) {
    result, ok := value.(T)
    if !ok {
        return result, false
    }
    if declared, translated := value.(interface{ GppJavaImplementsInterface(string) bool }); translated {
        return result, declared.GppJavaImplementsInterface(javaInterface)
    }
    // Go callers can implement the exported interface directly. Bundled
    // Java library types still use Java's nominal interface rules.
    return result, !isBundledJavaType(reflect.TypeOf(value))
}

func isBundledJavaType(valueType reflect.Type) bool {
    if valueType.Kind() == reflect.Pointer {
        valueType = valueType.Elem()
    }
    return valueType.PkgPath() == reflect.TypeFor[String]().PkgPath()
}

func CastInterface[T any](value any, javaInterface string) T {
    value = CanonicalReference(value)
    if value == nil {
        var zero T
        return zero
    }
    result, ok := interfaceView[T](value, javaInterface)
    if !ok {
        Raise(&ClassCastException{})
    }
    return result
}

func InstanceOfInterface[T any](value any, javaInterface string) bool {
    _, ok := MatchInterface[T](value, javaInterface)
    return ok
}

// MatchInterface retains Java interface membership when binding a pattern.
func MatchInterface[T any](value any, javaInterface string) (T, bool) {
    return interfaceView[T](NormalizeReference(CanonicalReference(value)), javaInterface)
}
