package gpp.java

import "fmt"

// raisedException is private so ordinary Go panic values and structurally
// similar types do not become catchable errors.
type raisedException struct {
    cause error
}

func (raised raisedException) GppThrownError() error { return raised.cause }

// Raise propagates a non-nil error through translated Java and GPP frames
// using this runtime, including frames in other Go modules.
func Raise(cause error) {
    if cause != nil {
        panic(raisedException{cause: cause})
    }
}

// UnwrapRaised recognizes only exceptions raised by this runtime.
func UnwrapRaised(recovered any) (error, bool) {
    raised, ok := recovered.(raisedException)
    return raised.cause, ok
}

// Throwable is the Go-facing contract for errors with a Java class identity.
type Throwable interface {
    error
    JavaClassName() string
}

// RuntimeException identifies exceptions that Java treats as unchecked.
type RuntimeException interface {
    Throwable
    JavaRuntimeException()
}

// IllegalArgumentException preserves the Java validation error type at Go call sites.
type IllegalArgumentException struct {
    Message string
}

func (exception *IllegalArgumentException) Error() string {
    return exception.Message
}

func (exception *IllegalArgumentException) JavaClassName() string {
    return "java.lang.IllegalArgumentException"
}

func (exception *IllegalArgumentException) JavaRuntimeException() {}

type NullPointerException struct {
    _ byte
}

func (*NullPointerException) Error() string { return "java.lang.NullPointerException" }

func (*NullPointerException) JavaClassName() string { return "java.lang.NullPointerException" }

func (*NullPointerException) JavaRuntimeException() {}

type StringIndexOutOfBoundsException struct {
    Index int32
    Length int
}

func (exception *StringIndexOutOfBoundsException) Error() string {
    return fmt.Sprintf("Index %d out of bounds for length %d", exception.Index, exception.Length)
}

func (*StringIndexOutOfBoundsException) JavaClassName() string { return "java.lang.StringIndexOutOfBoundsException" }

func (*StringIndexOutOfBoundsException) JavaRuntimeException() {}
