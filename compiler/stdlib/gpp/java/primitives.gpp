package gpp.java

import (
    "math"
    "strconv"
    "strings"
)

// LongFromDouble implements the floating-point to long conversion in JLS 5.1.3.
func LongFromDouble(value float64) int64 {
    if math.IsNaN(value) {
        return 0
    }
    if value >= 9223372036854775808.0 {
        return math.MaxInt64
    }
    if value <= -9223372036854775808.0 {
        return math.MinInt64
    }
    return int64(value)
}

// IntFromDouble implements the first step of narrowing to int, short, byte or char.
func IntFromDouble(value float64) int32 {
    if math.IsNaN(value) {
        return 0
    }
    if value >= 2147483648.0 {
        return math.MaxInt32
    }
    if value <= -2147483648.0 {
        return math.MinInt32
    }
    return int32(value)
}

// DoubleString returns the decimal representation specified by Java SE 27 Double.toString.
func DoubleString(value float64) string {
    return floatingString(value, 64)
}

// FloatString formats the original single-precision number.
func FloatString(value float32) string {
    return floatingString(float64(value), 32)
}

func floatingString(value float64, width int) string {
    if math.IsNaN(value) {
        return "NaN"
    }
    if math.IsInf(value, 1) {
        return "Infinity"
    }
    if math.IsInf(value, -1) {
        return "-Infinity"
    }

    scientific := strconv.FormatFloat(value, 'e', -1, width)
    mantissa, exponentText, _ := strings.Cut(scientific, "e")
    exponent, _ := strconv.Atoi(exponentText)
    if exponent >= -3 && exponent < 7 {
        decimal := strconv.FormatFloat(value, 'f', -1, width)
        if !strings.Contains(decimal, ".") {
            decimal += ".0"
        }
        return decimal
    }

    // When a single digit round-trips, Java also considers the closest
    // two-digit decimal. This matters for values such as Double.MIN_VALUE.
    if !strings.Contains(mantissa, ".") {
        candidate := strconv.FormatFloat(value, 'e', 1, width)
        parsed, err := strconv.ParseFloat(candidate, width)
        if err == nil && parsed == value {
            mantissa, exponentText, _ = strings.Cut(candidate, "e")
            exponent, _ = strconv.Atoi(exponentText)
        } else {
            mantissa += ".0"
        }
    }
    return mantissa + "E" + strconv.Itoa(exponent)
}
