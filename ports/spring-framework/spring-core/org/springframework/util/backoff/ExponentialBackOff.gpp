// Ported from ExponentialBackOff in Spring Framework 7.1.0.
package org.springframework.util.backoff

import (
    "fmt"
    "math"
    "math/rand"
    "strconv"

    "gpp/java"
)

const (
    ExponentialBackOffDEFAULT_INITIAL_INTERVAL int64 = 2000
    ExponentialBackOffDEFAULT_JITTER int64 = 0
    ExponentialBackOffDEFAULT_MULTIPLIER float64 = 1.5
    ExponentialBackOffDEFAULT_MAX_INTERVAL int64 = 30000
    ExponentialBackOffDEFAULT_MAX_ELAPSED_TIME int64 = math.MaxInt64
    ExponentialBackOffDEFAULT_MAX_ATTEMPTS int64 = math.MaxInt64
)

class ExponentialBackOff {
    initialInterval int64
    jitter int64
    multiplier float64
    maxInterval int64
    maxElapsedTime int64
    maxAttempts int64

    func init() {
        this.initialInterval = ExponentialBackOffDEFAULT_INITIAL_INTERVAL
        this.jitter = ExponentialBackOffDEFAULT_JITTER
        this.multiplier = ExponentialBackOffDEFAULT_MULTIPLIER
        this.maxInterval = ExponentialBackOffDEFAULT_MAX_INTERVAL
        this.maxElapsedTime = ExponentialBackOffDEFAULT_MAX_ELAPSED_TIME
        this.maxAttempts = ExponentialBackOffDEFAULT_MAX_ATTEMPTS
    }

    func init(initialInterval int64, multiplier float64) error {
        this()
        if err := this.SetMultiplier(multiplier); err != nil {
            return err
        }
        this.initialInterval = initialInterval
        return nil
    }

    func SetInitialInterval(initialInterval int64) {
        this.initialInterval = initialInterval
    }

    func GetInitialInterval() int64 {
        return this.initialInterval
    }

    func SetJitter(jitter int64) error {
        if jitter < 0 {
            return &java.IllegalArgumentException{Message: fmt.Sprintf("Invalid jitter '%d': must be >= 0.", jitter)}
        }
        this.jitter = jitter
        return nil
    }

    func GetJitter() int64 {
        return this.jitter
    }

    func SetMultiplier(multiplier float64) error {
        if !(multiplier >= 1) {
            return &java.IllegalArgumentException{Message: fmt.Sprintf(
                    "Invalid multiplier '%s': Should be greater than or equal to 1. A multiplier of 1 is equivalent to a fixed interval.",
                    java.DoubleString(multiplier))}
        }
        this.multiplier = multiplier
        return nil
    }

    func GetMultiplier() float64 {
        return this.multiplier
    }

    func SetMaxInterval(maxInterval int64) {
        this.maxInterval = maxInterval
    }

    func GetMaxInterval() int64 {
        return this.maxInterval
    }

    func SetMaxElapsedTime(maxElapsedTime int64) {
        this.maxElapsedTime = maxElapsedTime
    }

    func GetMaxElapsedTime() int64 {
        return this.maxElapsedTime
    }

    func SetMaxAttempts(maxAttempts int64) {
        this.maxAttempts = maxAttempts
    }

    func GetMaxAttempts() int64 {
        return this.maxAttempts
    }

    func Start() BackOffExecution {
        return exponentialBackOffExecution(this)
    }

    func String() string {
        return fmt.Sprintf("ExponentialBackOff[initialInterval=%d, jitter=%d, multiplier=%s, maxInterval=%d, maxElapsedTime=%d, maxAttempts=%d]",
            this.initialInterval, this.jitter, java.DoubleString(this.multiplier),
            this.maxInterval, this.maxElapsedTime, this.maxAttempts)
    }
}

func NewExponentialBackOff() *ExponentialBackOff {
    return ExponentialBackOff()
}

func NewExponentialBackOffWithSettings(initialInterval int64, multiplier float64) (*ExponentialBackOff, error) {
    backOff, err := ExponentialBackOff(initialInterval, multiplier)
    if err != nil {
        return nil, err
    }
    return backOff, nil
}

class exponentialBackOffExecution {
    owner *ExponentialBackOff
    currentInterval int64
    currentElapsedTime int64
    attempts int32

    func init(owner *ExponentialBackOff) {
        this.owner = owner
        this.currentInterval = -1
    }

    func NextBackOff() int64 {
        if this.currentElapsedTime >= this.owner.GetMaxElapsedTime() || int64(this.attempts) >= this.owner.GetMaxAttempts() {
            return BackOffExecutionSTOP
        }
        nextInterval := this.computeNextInterval()
        this.currentElapsedTime += nextInterval
        this.attempts++
        return nextInterval
    }

    func computeNextInterval() int64 {
        maxInterval := this.owner.GetMaxInterval()
        nextInterval := this.currentInterval
        if this.currentInterval < 0 {
            nextInterval = this.owner.GetInitialInterval()
        } else if this.currentInterval >= maxInterval {
            nextInterval = maxInterval
        } else {
            nextInterval = min(java.LongFromDouble(float64(this.currentInterval)*this.owner.GetMultiplier()), maxInterval)
        }
        this.currentInterval = nextInterval
        return min(this.applyJitter(nextInterval), maxInterval)
    }

    func applyJitter(interval int64) int64 {
        jitter := this.owner.GetJitter()
        if jitter <= 0 {
            return interval
        }
        initialInterval := this.owner.GetInitialInterval()
        scale := 1.0
        if initialInterval > 0 {
            scale = float64(interval) / float64(initialInterval)
        }
        applicableJitter := java.LongFromDouble(float64(jitter) * scale)
        least := max(interval-applicableJitter, initialInterval)
        most := min(interval+applicableJitter, this.owner.GetMaxInterval())
        return least + java.LongFromDouble(rand.Float64()*float64(most-least))
    }

    func String() string {
        interval := "n/a"
        if this.currentInterval >= 0 {
            interval = strconv.FormatInt(this.currentInterval, 10) + "ms"
        }
        return fmt.Sprintf("ExponentialBackOffExecution[currentInterval=%s, multiplier=%s, attempts=%d]",
            interval, java.DoubleString(this.owner.GetMultiplier()), this.attempts)
    }
}
